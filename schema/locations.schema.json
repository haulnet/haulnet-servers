{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haulnet.github.io/haulnet-servers/schema/locations.schema.json",
  "title": "Haulnet registry locations",
  "description": "Fixed regions and the controlled list of cities. Cross-checks (unique ids, slugs, order) are done by tools/registry.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["regions", "cities"],
  "properties": {
    "$schema": { "type": "string" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$", "maxLength": 32 },
          "name": { "type": "string", "pattern": "^[A-Z][a-z]+( [A-Z][a-z]+)*$", "maxLength": 32 }
        }
      }
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "country", "region"],
        "properties": {
          "id": {
            "description": "Slug of the name: lowercase ASCII, words joined by '-'.",
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$",
            "maxLength": 40
          },
          "name": {
            "description": "Common English name in ASCII: words start with a capital letter, separated by a space or '-'; an apostrophe may join letters.",
            "type": "string",
            "pattern": "^[A-Z][a-z]*('[A-Za-z][a-z]*)*([ -][A-Z][a-z]*('[A-Za-z][a-z]*)*)*$",
            "minLength": 2,
            "maxLength": 40
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 code.",
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "region": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" }
        }
      }
    }
  }
}
